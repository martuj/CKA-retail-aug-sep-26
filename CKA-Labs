apiVersion: batch/v1
kind: CronJob
metadata:
  name: cleanup-cron
spec:
  schedule: "*/1 * * * *"   # Every 1 min
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      ttlSecondsAfterFinished: 120 # Clean up after 120 mins
      template:
        spec:
          restartPolicy: Never
          containers:
          - name: cleaner
            image: alpine:3.19
            command: ["sh", "-c", "rm -rf /tmp/*"]


successfulJobsHistoryLimit: 2 → keeps last 2 successful runs only.
failedJobsHistoryLimit: 1 → keeps last failed run only.
ttlSecondsAfterFinished: 120 → delete jobs after 120 mins.
