#!/bin/bash

# Define users and passwords
users=("user11" "user12" "user13" "user14" "user15")
passwords=("Pass@123" "Pass@123" "Pass@123" "Pass@123" "Pass@123")

# Loop through users
for i in ${!users[@]}
do
    username=${users[$i]}
    password=${passwords[$i]}

    echo "Creating user: $username"

    # Create user with home directory and bash shell
    sudo useradd -m -s /bin/bash $username

    # Set password
    echo "$username:$password" | sudo chpasswd

    # if you wanted add use into docker group (note: this command will run only after installation of docker)
    # sudo usermod -aG docker $username

    # Optional: force password change at first login
     #sudo chage -d 0 $username

done

echo " All users created successfully"


# save the file

chmod +x create_users.sh

sudo ./create_users.sh


