# create script to access Kubernetes by these users 

 vi  k8susers.sh

for user in user11 user12 user13 user14 user15
do
  sudo mkdir -p /home/$user/.kube
  sudo cp /home/ubuntu/.kube/config /home/$user/.kube/config
  sudo chown -R $user:$user /home/$user/.kube
  sudo mkdir -p /home/$user/.ssh
  sudo cp /home/ubuntu/.ssh/authorized_keys /home/$user/.ssh/
  sudo chown -R $user:$user /home/$user/.ssh
  sudo chmod 700 /home/$user/.ssh
  sudo chmod 600 /home/$user/.ssh/authorized_keys
done

echo " All users created successfully"


